rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Imagenes de los signos zodiacales
    match /zodiaco/{archivo} {
      // Cualquiera puede ver las imagenes (se muestran en las tarjetas)
      allow read: if true;

      // Solo usuarios autenticados pueden subir imagenes de hasta 5 MB
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Todo lo demas queda cerrado
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
